// The extension host ABI.
//
// This package evolves additively: every later 1.x release MUST be a strict
// superset of the previous one. Add new functions, interfaces, types or
// worlds, but never remove, rename, reorder or change the signature of
// anything already released here. Released snapshots live in ../wit-released
// and are checked by `released_host_abis_are_preserved` in the runtime tests.
// See docs/extensions.md#host-abi-evolution.
//
// Components have no WASI. A component may target the combined
// `attricat-extension` world or one of the narrower worlds below; the host
// links every import for every invocation and only calls the export that the
// invocation needs. Imports that are meaningless for an invocation return an
// error instead of being absent: run-bound interfaces (artifacts, attricat-data,
// catalog, transfer, selection) fail outside an operation run, and direct
// catalog reads/writes through `api` fail inside one, because operation runs
// access catalog data only through their run-scoped interfaces.
package attricat:host@1.0.0;

interface api {
  record event {
    id: string,
    event-type: string,
    aggregate-kind: string,
    aggregate-id: string,
    correlation-id: string,
    causation-id: option<string>,
    payload: string,
  }

  /// Attricat values use JSON because their type is defined by the owning
  /// blueprint. Every JSON field is bounded by the host to 64 KiB.
  record record-reference { record-id: string }
  record resolved-read { record-id: string, context-id: string }
  variant read-request {
    %record(record-reference),
    values(record-reference),
    resolved(resolved-read),
  }
  record read-response {
    %record: string,
    blueprint: string,
    direct-values: string,
    resolved-values: option<string>,
  }

  record scalar-write {
    attribute-id: option<string>,
    attribute-code: option<string>,
    context-id: string,
    value: string,
  }
  record write-request { record-id: string, values: list<scalar-write> }
  record write-response { values: string }

  enum configuration-scope-kind { blueprint, attribute }
  record configuration-scope {
    kind: configuration-scope-kind,
    blueprint-id: string,
    blueprint-version: s64,
    attribute-id: option<string>,
  }
  record scoped-configuration-update {
    scope: configuration-scope,
    value: string,
  }

  read: func(request: read-request) -> result<read-response, string>;
  write: func(request: write-request) -> result<write-response, string>;
  scoped-configuration-get: func(scope: configuration-scope) -> result<option<string>, string>;
  scoped-configuration-set: func(request: scoped-configuration-update) -> result<_, string>;
  /// Generic capability-mediated calls, including secrets.get.v1 and
  /// network.request.v1. Attricat data also has the typed read and write above.
  call: func(operation: string, request: string) -> result<string, string>;
  log: func(level: string, message: string) -> result<_, string>;
}

interface handler {
  use api.{event};
  record command-request { handler: string, payload: string }
  record command-response { payload: string }
  handle-event: func(event: event) -> result<_, string>;
  /// Invoked only through a manifest-declared, authorized client command.
  handle-command: func(request: command-request) -> result<command-response, string>;
}

interface artifacts {
  resource input-artifact;
  resource output-artifact;

  record input-metadata { content-length: u64, media-type: string, checksum-sha256: string }
  record output-metadata { artifact-id: string, content-length: u64, media-type: string, checksum-sha256: string }

  open-input: func(artifact-id: string) -> result<input-artifact, string>;
  describe-input: func(handle: borrow<input-artifact>) -> result<input-metadata, string>;
  read: func(handle: borrow<input-artifact>, max-bytes: u32) -> result<list<u8>, string>;

  create-output: func(media-type: string) -> result<output-artifact, string>;
  write: func(handle: borrow<output-artifact>, bytes: list<u8>) -> result<_, string>;
  complete: func(handle: own<output-artifact>, checksum-sha256: string) -> result<output-metadata, string>;
  abort: func(handle: own<output-artifact>) -> result<_, string>;

  // Run-bound staging survives invocations and worker restarts. Each batch key
  // is accepted at most once per output name, with identical bytes on replay.
  append-output: func(name: string, media-type: string, batch-key: string, bytes: list<u8>) -> result<_, string>;
  finalize-output: func(name: string) -> result<string, string>;
}

// JSON payloads are bounded to 64 KiB. Page limits and intent limits are
// enforced in the repository. Batch keys are scoped to the durable run.
interface attricat-data {
  read: func(request: string) -> result<string, string>;
  batch: func(request: string) -> result<string, string>;
}

// Connector-oriented typed selectors. JSON results remain bounded to 64 KiB.
interface attricat {
  schema: func(blueprint-id: string, blueprint-version: u64, context-id: string) -> result<string, string>;
  page: func(blueprint-id: string, blueprint-version: u64, context-id: string, cursor: string, limit: u32) -> result<string, string>;
  upsert-batch: func(request: string) -> result<_, string>;
}

// JSON control envelopes contain only URL, permission ID, secret references,
// source identity, range and artifact ID. Bytes never transit this interface.
interface transfer {
  fetch-input: func(request: string) -> result<string, string>;
  deliver-output: func(request: string) -> result<string, string>;
}

// Run-bound, immutable selection of an interactive operation. Pages contain
// saved values resolved in the run's pinned context, the caller's own
// annotation namespace and source identity. JSON results are bounded to 64 KiB.
// Members the initiator can no longer read are returned without data.
interface selection {
  describe: func() -> result<string, string>;
  page: func(cursor: string, limit: u32) -> result<string, string>;
}

interface operations {
  record operation-request { run-id: string, operation-id: string, configuration: string, input: string, checkpoint: string, batch-key: string }
  record batch-result { checkpoint: string, progress: string, done: bool }
  prepare: func(request: operation-request) -> result<string, string>;
  start: func(request: operation-request) -> result<string, string>;
  process-batch: func(request: operation-request) -> result<batch-result, string>;
  checkpoint: func(request: operation-request) -> result<_, string>;
  finish: func(request: operation-request) -> result<_, string>;
  cancel: func(request: operation-request) -> result<_, string>;
}

/// Every host import. Worlds below differ only in exports.
world imports {
  import api;
  import artifacts;
  import attricat-data;
  import attricat;
  import transfer;
  import selection;
}

/// Event handlers and client commands.
world handler-extension {
  include imports;
  export handler;
}

/// Checkpointed (scheduled, connector and interactive) operations.
world operation-extension {
  include imports;
  export operations;
}

/// Event handlers, client commands and operations in one component.
world attricat-extension {
  include imports;
  export handler;
  export operations;
}
